# 复制为 .env 后填写；.env 已被 .gitignore 忽略，绝不提交到仓库。

# ── 扶摇（同花顺金融数据 API）── 主数据源：行情、估值、财务、指数成分、交易日历
# 申请：用同花顺账号登录 https://fuyao.aicubes.cn/admin →「创建 API Key」
FUYAO_API_KEY=
FUYAO_BASE_URL=https://fuyao.aicubes.cn

# ── iFinD MCP ── 补充数据源：候选股新闻/公告等背景资讯（不参与打分）
# 申请：登录 https://mcp.51ifind.com → 个人中心 → 复制 token
IFIND_MCP_TOKEN=
IFIND_MCP_URL=https://api-mcp.51ifind.com:8643/ds-mcp-servers/hexin-ifind-ds-mcp

# ── 大模型（OpenAI 兼容接口，默认 DeepSeek）── 负责意图解析、澄清、解释文案
# 申请：https://platform.deepseek.com/api_keys
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ── Render（仅本地部署脚本使用，应用不读取）──
RENDER_API_KEY=
